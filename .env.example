# Vector Foundry - Environment Variables Template
# Copy to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME="Vector Foundry"
APP_VERSION=1.0.0
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/vector_foundry.db
DATABASE_ECHO=false

# Keycloak OIDC (configure Keycloak first, then fill these in)
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=vector-foundry
KEYCLOAK_CLIENT_ID=vector-foundry-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# OIDC Discovery (operator-configured, optional if using Keycloak defaults)
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=vector-foundry-api
OIDC_JWKS_CACHE_TTL=3600

# Demo mode (explicitly enabled, refuses in production)
DEMO_MODE=false

# LLM Providers (optional - for AI insights)
# Supported: openai-compatible, anthropic, gemini, ollama
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2

# GitHub API (for issue ingestion - optional but recommended)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_REPO_OWNER=rust-lang
GITHUB_REPO_NAME=rust

# CORS
CORS_ORIGINS=http://localhost:5173

# Security
SECRET_KEY=dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30